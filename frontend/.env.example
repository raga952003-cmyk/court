# Supabase (required) — use ANON/public key only, never service_role
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Backend API base (leave empty when Nginx proxies /api on same host)
VITE_API_BASE_URL=

# Show simulated-time demo header (set true only for demos)
VITE_SHOW_SIMULATED_TIME=false
