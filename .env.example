# TCS PlaySmart - Environment Variables Template

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Your Supabase Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# IMPORTANT: SERVICE ROLE KEY for backend only (never put in frontend / VITE_*)
SUPABASE_KEY=your_service_role_key_here

# Frontend build vars (anon key — safe for browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
VITE_SHOW_SIMULATED_TIME=false
VITE_API_BASE_URL=

# Groq AI (server-side only — used by POST /api/ai/chat)
GROQ_API_KEY=your_groq_api_key

# Comma-separated origins, or * for all (prefer your EC2 URL in production)
CORS_ORIGINS=*

# ============================================
# EMAIL CONFIGURATION (Real Gmail Sending)
# ============================================
# By default, emails are stored in database only (simulated mode)
# To send real emails, enable this and configure SMTP settings

# Enable/Disable real email sending
ENABLE_REAL_EMAILS=false

# Preferred on corporate networks (HTTPS :443) — Brevo → SMTP & API → API keys
# BREVO_API_KEY=xkeysib-xxxxxxxx

# Gmail / Brevo SMTP (often blocked on office Wi‑Fi — use BREVO_API_KEY instead)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login@smtp-brevo.com
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM_EMAIL=your_verified_sender@gmail.com
SMTP_FROM_NAME=TCS PlaySmart

# ============================================
# DATABASE DIRECT CONNECTION (Optional)
# ============================================
# For running migrations or direct database access
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.kmcecytuzizhiokvwnlq.supabase.co:5432/postgres

# ============================================
# FALLBACK MODE
# ============================================
# If SUPABASE_URL or SUPABASE_KEY is empty, the app will use SQLite as fallback
# SQLite database file: backend/playsmart_sandbox.db
